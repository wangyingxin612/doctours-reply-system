# Copy to .env and fill in. .env is gitignored.

# Required for any message that reaches a model.
# Messages the guard escalates need no key.
ANTHROPIC_API_KEY=

# Optional. The values shown are the defaults.
# ROUTER_MODEL=claude-haiku-4-5-20251001
# RESPONDER_MODEL=claude-sonnet-5-5
# RESPONDER_EFFORT=low
# LLM_MAX_RETRIES=5
# ROUTER_ATTEMPT_TIMEOUT_MS=8000
# CONCURRENCY=4

# Optional, off by default. "default" turns on Anthropic's server-side refusal fallback (beta):
# some requests the responder model declines are retried by the API on an earlier model.
# RESPONDER_FALLBACKS=off
